{
  "version": 1,
  "comment": "Bone maps from SOMA joint names (the 30 joints MotionBricks predicts, plus the SOMA joints they hang off) to bone names of the source rigs. Names were read from the Blender FBX import of Kevin Iglesias HumanM clips and PROTOFACTOR Humanoid@ clips. Matching is exact first, then by normalised name (lower case, prefixes such as 'B-', 'humanoid_', 'mixamorig:' and all punctuation removed), so small naming differences between pack versions still resolve. SOMA joints that are not listed stay in the SOMA rest pose (Spine2/Neck2/Jaw/Eyes and all finger joints). Bones in 'passthrough_regex' (fingers) are not sent to MotionBricks; on the way back they are blended between the start-frame and end-frame finger pose of the source clips.",
  "required_core": ["Hips", "Head", "LeftArm", "RightArm", "LeftLeg", "RightLeg"],
  "aim_candidates": {
    "Hips": ["Chest", "Spine2", "Spine1", "Neck1"],
    "Spine1": ["Chest", "Spine2", "Neck1"],
    "Spine2": ["Chest", "Neck1"],
    "Chest": ["Neck1", "Head"],
    "Neck1": ["Head"],
    "LeftShoulder": ["LeftArm"],
    "LeftArm": ["LeftForeArm"],
    "LeftForeArm": ["LeftHand"],
    "RightShoulder": ["RightArm"],
    "RightArm": ["RightForeArm"],
    "RightForeArm": ["RightHand"],
    "LeftLeg": ["LeftShin"],
    "LeftShin": ["LeftFoot"],
    "LeftFoot": ["LeftToeBase"],
    "RightLeg": ["RightShin"],
    "RightShin": ["RightFoot"],
    "RightFoot": ["RightToeBase"]
  },
  "rigs": [
    {
      "id": "kevin_humanm",
      "label": "Kevin Iglesias HumanM (B- bone names)",
      "pack_pattern": "kevin|iglesias|humanm",
      "map": {
        "Hips": "B-hips",
        "Spine1": "B-spine",
        "Chest": "B-chest",
        "Neck1": "B-neck",
        "Head": "B-head",
        "LeftShoulder": "B-shoulder.L",
        "LeftArm": "B-upperArm.L",
        "LeftForeArm": "B-forearm.L",
        "LeftHand": "B-hand.L",
        "RightShoulder": "B-shoulder.R",
        "RightArm": "B-upperArm.R",
        "RightForeArm": "B-forearm.R",
        "RightHand": "B-hand.R",
        "LeftLeg": "B-thigh.L",
        "LeftShin": "B-shin.L",
        "LeftFoot": "B-foot.L",
        "LeftToeBase": "B-toe.L",
        "RightLeg": "B-thigh.R",
        "RightShin": "B-shin.R",
        "RightFoot": "B-foot.R",
        "RightToeBase": "B-toe.R"
      },
      "passthrough_regex": "^B-(thumb|indexFinger|middleFinger|ringFinger|pinky)\\d+\\.[LR]$",
      "notes": "B-root, B-spineProxy, B-handProp.* and B-jaw are not driven (rest pose on the way back). Root motion is taken from the world position of B-hips, so it does not matter whether the clip animates B-root or B-hips."
    },
    {
      "id": "protofactor_actor",
      "label": "PROTOFACTOR SK_Protof-Actor / Humanoid@ clips (humanoid_ bone names)",
      "pack_pattern": "protofactor|protof|humanoid@",
      "map": {
        "Hips": "humanoid_ Pelvis",
        "Spine1": "humanoid_ Spine",
        "Spine2": "humanoid_ Spine1",
        "Chest": "humanoid_ Spine2",
        "Neck1": "humanoid_ Neck",
        "Head": "humanoid_ Head",
        "LeftShoulder": "humanoid_ L Clavicle",
        "LeftArm": "humanoid_ L UpperArm",
        "LeftForeArm": "humanoid_ L Forearm",
        "LeftHand": "humanoid_ L Hand",
        "RightShoulder": "humanoid_ R Clavicle",
        "RightArm": "humanoid_ R UpperArm",
        "RightForeArm": "humanoid_ R Forearm",
        "RightHand": "humanoid_ R Hand",
        "LeftLeg": "humanoid_ L Thigh",
        "LeftShin": "humanoid_ L Calf",
        "LeftFoot": "humanoid_ L Foot",
        "LeftToeBase": "humanoid_ L Toe0",
        "RightLeg": "humanoid_ R Thigh",
        "RightShin": "humanoid_ R Calf",
        "RightFoot": "humanoid_ R Foot",
        "RightToeBase": "humanoid_ R Toe0"
      },
      "passthrough_regex": "^humanoid_+\\s*[LR] Finger\\d+$",
      "notes": "The bones 'humanoid_' (a duplicate of the pelvis), 'root', 'humanoid_ Ponytail1' are not driven. In the PROTOFACTOR clip files the FBX default (rest) pose is not a T-pose, so arm/forearm twist is derived by shortest-arc alignment and may be off by some degrees for the model; the way back is the exact inverse, so the endpoint poses you picked are reproduced exactly on the source rig."
    },
    {
      "id": "generic",
      "label": "Generic humanoid (name heuristics: Mixamo, Unity Humanoid, Bip01, ...)",
      "pack_pattern": "",
      "normalized_candidates": {
        "Hips": ["hips", "pelvis", "hip"],
        "Spine1": ["spine", "spine0", "spine01"],
        "Chest": ["chest", "spine2", "spine02", "spine1", "upperchest", "spine03"],
        "Neck1": ["neck", "neck1", "neck01"],
        "Head": ["head"],
        "LeftShoulder": ["leftshoulder", "lshoulder", "shoulderl", "leftclavicle", "lclavicle", "claviclel", "leftcollar"],
        "LeftArm": ["leftarm", "leftupperarm", "larm", "lupperarm", "upperarml", "armleft"],
        "LeftForeArm": ["leftforearm", "leftlowerarm", "lforearm", "llowerarm", "forearml", "lowerarml"],
        "LeftHand": ["lefthand", "lhand", "handl"],
        "RightShoulder": ["rightshoulder", "rshoulder", "shoulderr", "rightclavicle", "rclavicle", "clavicler", "rightcollar"],
        "RightArm": ["rightarm", "rightupperarm", "rarm", "rupperarm", "upperarmr", "armright"],
        "RightForeArm": ["rightforearm", "rightlowerarm", "rforearm", "rlowerarm", "forearmr", "lowerarmr"],
        "RightHand": ["righthand", "rhand", "handr"],
        "LeftLeg": ["leftupleg", "leftupperleg", "leftthigh", "lupleg", "lthigh", "thighl", "upperlegl"],
        "LeftShin": ["leftleg", "leftlowerleg", "leftshin", "leftcalf", "lleg", "lcalf", "lshin", "calfl", "shinl", "lowerlegl"],
        "LeftFoot": ["leftfoot", "lfoot", "footl", "leftankle"],
        "LeftToeBase": ["lefttoebase", "lefttoe", "ltoe", "ltoe0", "toel", "lefttoes"],
        "RightLeg": ["rightupleg", "rightupperleg", "rightthigh", "rupleg", "rthigh", "thighr", "upperlegr"],
        "RightShin": ["rightleg", "rightlowerleg", "rightshin", "rightcalf", "rleg", "rcalf", "rshin", "calfr", "shinr", "lowerlegr"],
        "RightFoot": ["rightfoot", "rfoot", "footr", "rightankle"],
        "RightToeBase": ["righttoebase", "righttoe", "rtoe", "rtoe0", "toer", "righttoes"]
      },
      "passthrough_regex": "(thumb|index|middle|ring|pinky|finger)",
      "notes": "Fallback for rigs without an explicit map. Check the 'unmapped' list in the job log."
    }
  ]
}
