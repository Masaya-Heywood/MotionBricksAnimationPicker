{
  "port": 8770,
  "motionbricks_dir": "C:\\Users\\User\\motionbricks",
  "blender_exe": "D:\\blender.exe",
  "animationlab_root": "D:\\AnimationLab",
  "source_fbx_dir": "source_fbx",
  "soma_bvh_dir": "soma_bvh",
  "generated_dir": "generated",
  "export_fbx_dir": "export_fbx",
  "cache_dir": "helper_cache",
